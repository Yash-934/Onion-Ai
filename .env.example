# ==========================================
# Private AI Gateway Environment Config
# ==========================================

# Gateway Authentication (Client <-> Gateway)
# Set a secure random string. Clients (PocketForge / Android) must provide this as x-api-key or Bearer token.
# Leave blank to disable gateway authentication (not recommended in production).
GATEWAY_API_KEY=your-secret-gateway-api-key

# Upstream Model Configuration (Gateway <-> Upstream Provider)
# UPSTREAM_PROTOCOL: "anthropic" (native Anthropic Messages API) or "openai" (OpenAI Chat Completions)
UPSTREAM_PROTOCOL=openai
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=your-upstream-provider-api-key
ANTHROPIC_VERSION=2023-06-01

# Model Names / Identifiers
CHAT_MODEL=claude-3-7-sonnet-20250219
CODE_MODEL=claude-3-7-sonnet-20250219
IMAGE_MODEL=dall-e-3

# Security & Limits
REQUEST_TIMEOUT_SECONDS=120
MAX_REQUEST_BYTES=10485760
