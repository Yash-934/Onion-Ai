# ==========================================================
# Example Server-side Tor v3 Onion Service Configuration
# ==========================================================
# Add these lines to /etc/tor/torrc or /usr/local/etc/tor/torrc
#
# Ensure permissions on HiddenServiceDir are 0700:
#   sudo chown -R debian-tor:debian-tor /var/lib/tor/private-ai/
#   sudo chmod 700 /var/lib/tor/private-ai/

HiddenServiceDir /var/lib/tor/private-ai/
HiddenServicePort 80 127.0.0.1:8443
HiddenServicePort 443 127.0.0.1:8443
HiddenServiceVersion 3

# The API process runs locally on 127.0.0.1:8443 (bound only to localhost).
# Tor maps incoming connections from the .onion address to the local gateway.
# Read the generated hostname at: /var/lib/tor/private-ai/hostname
